<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="TenantAdminHardening">
      <file>tests/Modules/TenantAdmin/DataIntegrityAndHardeningTest.php</file>
      <file>tests/Modules/TenantAdmin/TenantIsolationSecurityTest.php</file>
      <file>tests/Modules/TenantAdmin/MultiTenantIsolationMatrixTest.php</file>
      <file>tests/Modules/TenantAdmin/SecurityGuardsAndStorageVerificationTest.php</file>
      <file>tests/Modules/TenantAdmin/PublishingManifestVerificationTest.php</file>
      <file>tests/Modules/TenantAdmin/TenantAdminApiTest.php</file>
    </testsuite>
    <testsuite name="SuperAdmin">
      <file>tests/Modules/SuperAdmin/SuperAdminApiTest.php</file>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <env name="CACHE_DRIVER" value="array"/>
    <env name="DB_CONNECTION" value="mysql"/>
    <env name="DB_HOST" value="127.0.0.1"/>
    <env name="DB_PORT" value="3307"/>
    <env name="DB_DATABASE" value="dogy_saas_test"/>
    <env name="DB_USERNAME" value="root"/>
    <env name="DB_PASSWORD" value=""/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="TELESCOPE_ENABLED" value="false"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
